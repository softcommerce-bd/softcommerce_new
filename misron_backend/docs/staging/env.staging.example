# T-5 staging environment TEMPLATE. Copy to the staging server's environment (never commit real values, never reuse production secrets).
# Every value below is a placeholder or a safe default. Lines marked MUST are part of the T-5 safety design.

APP_ENV=staging
APP_DEBUG=false
APP_KEY=<generate on the server: php artisan key:generate --show>
APP_URL=https://<staging host>

# --- database: a staging database that is NOT production and holds NO real customers' money (masked restore of a backup) ---
DB_CONNECTION=mysql
DB_HOST=<staging db host>
DB_PORT=3306
DB_DATABASE=<staging database name>
DB_USERNAME=<staging db user (not the production user)>
DB_PASSWORD=<set on the server only>
# MUST: one connection per request, no multiplexing proxy, no persistent connections (INC.1)
# DB_PERSISTENT is not used by this application; do not add PDO::ATTR_PERSISTENT.

# --- T-5 safety switches (MUST) ---
FINANCIAL_ENGINE_POLICY=enforce          # enforce (default): purchasing/supplier changes refused while their tables are not InnoDB. warn/off only by written decision.
INVENTORY_CONFIRMED_ONLY=false           # stays false until the owner's written P6 approval
# AUTO_DEPOSIT_APPROVED is deliberately NOT set (the nightly auto-deposit job stays paused). Never set it without an approved AD-1 option.
# AUTO_DEPOSIT_USER_ID is deliberately NOT set.

# --- files: must be explicit (the code now defaults to 'local' but the setting must still be deliberate) ---
FILESYSTEM_DRIVER=local

# --- schedulers/workers: exactly ONE scheduler host (withoutOverlapping is per cache store) ---
CACHE_DRIVER=<file|redis>
QUEUE_CONNECTION=<sync|redis>

# --- external services: staging must NOT reach real payment gateways, couriers or SMS with live keys ---
# leave gateway/courier/SMS credentials empty or use sandbox credentials only
